{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "linux",
      "displayName": "Linux development",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake/linux",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "ROHR_BUILD_OUTPUT_DIRECTORY": "${sourceDir}/build",
        "ROHR_BUILD_EXAMPLES": "ON",
        "ROHR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows 10/11 development",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/cmake/windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "ROHR_BUILD_OUTPUT_DIRECTORY": "${sourceDir}/build",
        "ROHR_BUILD_EXAMPLES": "ON",
        "ROHR_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows x64 cross-compile from Linux",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake/windows-cross",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-w64.cmake",
        "ROHR_BUILD_OUTPUT_DIRECTORY": "${sourceDir}/build/windows-cross",
        "ROHR_BUILD_EXAMPLES": "ON",
        "ROHR_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-examples",
      "configurePreset": "linux",
      "targets": ["examples"]
    },
    {
      "name": "linux-tests",
      "configurePreset": "linux",
      "targets": ["rohr_tests"]
    },
    {
      "name": "windows-debug",
      "configurePreset": "windows",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows",
      "configuration": "Release"
    },
    {
      "name": "windows-examples",
      "configurePreset": "windows",
      "configuration": "Debug",
      "targets": ["examples"]
    },
    {
      "name": "windows-tests",
      "configurePreset": "windows",
      "configuration": "Debug",
      "targets": ["rohr_tests"]
    },
    {
      "name": "windows-cross",
      "configurePreset": "windows-cross"
    }
  ],
  "testPresets": [
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
